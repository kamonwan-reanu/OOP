class Schedule {
    private int hour;
    
    public Schedule(int hour) {
        this.hour = hour;
    }
    
    public void setHour(int newHour) {
        this.hour = newHour;
    }
    
    public int getHour() {
        return hour;
    }
    
    public Schedule(Schedule other) {
        this.hour = other.hour;
    }
}


class EmployeeSchedule {
    private String name;
    private Schedule schedule;
    
    public EmployeeSchedule(String name, Schedule schedule) {
        this.name = name;
        this.schedule = schedule;
    }
    
    public EmployeeSchedule(EmployeeSchedule other) {
        this.name = other.name;
        this.schedule = new Schedule(other.schedule);
    }
    
    public void displaySchedule() {
        int hour = schedule.getHour();
        int displayHour = hour;
        String period;
        
        if (hour == 0) {
            displayHour = 12;
            period = "00";
        } else if (hour < 12) {
            period = "00";
        } else if (hour == 12) {
            period = "00";
        } else {
            displayHour = hour - 12;
            period = "00";
        }
        
        System.out.println(name + ": " + displayHour + ":" + period);
    }
}


public class Main {
    public static void main(String[] args) {
        java.util.Scanner scanner = new java.util.Scanner(System.in);
        
        String name1 = scanner.nextLine();
        int hour1 = scanner.nextInt();
        int adjustHour1 = scanner.nextInt();
        scanner.nextLine();
        
        Schedule sch1 = new Schedule(hour1);
        sch1.setHour(adjustHour1);
        
        Schedule sch2 = new Schedule(sch1);
        
        EmployeeSchedule emp1 = new EmployeeSchedule(name1, sch2);
        
        sch1.setHour(hour1);
        
        emp1.displaySchedule();
        
        EmployeeSchedule emp2 = new EmployeeSchedule(emp1);
        
        emp1.displaySchedule();
        emp2.displaySchedule();
        
        scanner.close();
    }
}