class Animal {
    protected String name;
    protected int age;

    public void displayInfo() {
        System.out.println("Name: " + name + ", Age: " + age);
    }
}

class Dog extends Animal {
    public void makeSound() {
        System.out.println("Woof! Woof!");
    }
}

public class Main {
    public static void main(String[] args) {
        Dog dog = new Dog();
        
        dog.name = "Buddy";
        dog.age = 3;
        dog.makeSound();
        dog.displayInfo();
        
        System.out.println();
        
        Dog dog2 = new Dog();
        dog2.name = "Luna";
        dog2.age = 1;
        dog2.makeSound();
        dog2.displayInfo();
        
        System.out.println();
        
        Dog dog3 = new Dog();
        dog3.name = "Max Power";
        dog3.age = 5;
        dog3.makeSound();
        dog3.displayInfo();
        
        System.out.println();
        
        Dog dog4 = new Dog();
        dog4.name = "Rocky";
        dog4.age = 2;
        dog4.makeSound();
        dog4.displayInfo();
    }
}