class Media {
    protected String title;
    
    public Media(String title) {
        this.title = title;
    }
    
    public void process() {
        System.out.println("Starting generic media processing.");
    }
}


class Video extends Media {
    protected int duration;
    
    public Video(String title, int duration) {
        super(title);
        this.duration = duration;
    }
    
    @Override
    public void process() {
        System.out.println("Processing video: " + title + " for " + duration + " minutes.");
    }
}


class Audio extends Media {
    protected String quality;
    
    public Audio(String title, String quality) {
        super(title);
        this.quality = quality;
    }
    
    @Override
    public void process() {
        System.out.println("Processing audio: " + title + " with " + quality + " quality.");
    }
}


class Processor {
    public static void runProcessor(Media media) {
        media.process();
    }
}


public class Main {
    public static void main(String[] args) {
        Video tutorial = new Video("Tutorial", 60);
        Processor.runProcessor(tutorial);
        
        Video song = new Video("Song 1", 3);
        Processor.runProcessor(song);
        
        Audio soundscape = new Audio("Soundscape", "Low Quality");
        Processor.runProcessor(soundscape);
        
        Video movieTrailer = new Video("Movie Trailer", 3);
        Processor.runProcessor(movieTrailer);
        
        Audio podcast = new Audio("Podcast EP1", "HD Audio");
        Processor.runProcessor(podcast);
        
        Video shortClip = new Video("Short Clip", 5);
        Processor.runProcessor(shortClip);
        
        Audio jingle = new Audio("Jingle", "Single");
        Processor.runProcessor(jingle);
    }
}